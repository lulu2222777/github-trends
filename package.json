{
  "name": "github-trends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自动抓取 GitHub 上高价值/高增长项目的闭环系统",
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "collect:quick": "node scripts/collect.mjs --only=all",
    "store": "node scripts/ingest.mjs",
    "score": "node scripts/score.mjs",
    "build": "node scripts/build.mjs",
    "pipeline": "npm run collect && npm run store && npm run score && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
